# Copy this file to app/.env and fill in your keys. Never commit .env.
#
# The develop voice demo needs BOTH keys:
#   ANTHROPIC_API_KEY — compose (streamed Sonnet, the one pipeline LLM call)
#   OPENAI_API_KEY    — STT + TTS on the demo host (default STT_BACKEND=openai)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- Optional overrides (see config.py for all CJ_* knobs) --------
# STT_BACKEND=openai            # openai (whisper-1) | local (faster-whisper, offline)
# LOCAL_STT_MODEL=base          # faster-whisper size when STT_BACKEND=local
# INFERENCE_MODEL=claude-sonnet-4-6
# CJ_EMBED_DEVICE=cuda          # cuda | cpu for the resident bge-base embedder

# --- LEGACY (pre-W1.8 kiosk only; NOT used by the develop pipeline) ---
# These are read only by app/cj_chat.py / voice_stream.PiperTTS (CJ_ALLOW_LEGACY
# path). The develop demo uses OpenAI STT/TTS, not local Whisper/Piper.
# WHISPER_MODEL=medium
# PIPER_BIN=./piper/piper.exe
# PIPER_VOICE=./voices/en_US-ryan-high.onnx
