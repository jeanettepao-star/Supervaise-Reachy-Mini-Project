# =============================================================
# CJ Panganiban conversation app — environment template
#
# Copy to one of:
#   <repo>/app/.env            (recommended; most specific)
#   <repo>/.env
#   <cwd>/.env
# All three are searched (by service._api_key and the legacy loader),
# later values overriding earlier ones (so app/.env wins). To point at
# a specific file, set DOTENV_PATH=<absolute path>.
#
# NOTE: the develop voice demo needs BOTH keys below. Defaults quoted in
# the comments track config.py — override a knob by uncommenting it.
# =============================================================

# --- Required: API keys -------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional: STT backend + models -------------------------------
# STT_BACKEND=openai            # default. openai (whisper-1) | local (faster-whisper, offline)
# LOCAL_STT_MODEL=base          # faster-whisper size when STT_BACKEND=local
# OPENAI_STT_MODEL=whisper-1    # (read by app/voice_io.py; the demo host uses whisper-1)

# --- Optional: composer model override ----------------------------
# INFERENCE_MODEL=claude-sonnet-4-6      # config default (the one pipeline LLM call)
# ROUTER_MODEL=claude-haiku-4-5-20251001 # LEGACY: DEPRECATED (W1.8). The develop
#                                        # router is zero-LLM; this is unused on the
#                                        # develop compose path (kiosk branch only).

# --- Optional: OpenAI TTS overrides -------------------------------
# These knobs are read by app/voice_io.py; config defaults shown. NOTE: the
# streamlit_voice_demo sidebar selects the TTS voice and the demo synthesizes with
# tts-1, so on the demo host these values are informational unless you use voice_io.
# OPENAI_TTS_MODEL=tts-1        # config default (or tts-1-hd for ~2x cost)
# OPENAI_TTS_VOICE=echo         # config default. tts-1 voices: onyx | echo | fable | nova | shimmer | alloy
# OPENAI_TTS_SPEED=0.98         # config default; 0.25-4.0 (<1 is slower — CJP's measured judicial pace)

# --- Optional: explicit .env path ---------------------------------
# DOTENV_PATH=D:\creds\flp\app.env
