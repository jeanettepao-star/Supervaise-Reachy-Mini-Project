# Secrets — NEVER commit
.env
.env.local
*.key
**/.env
**/.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.Python
*.egg-info/
.pytest_cache/
**/.venv/

# Large model/binary assets (each user installs locally)
app/voices/*.onnx
app/voices/*.onnx.json
app/piper/
**/piper/piper.exe
**/piper/*.dll
**/piper/espeak-ng-data/

# Whisper model cache
.cache/
models/

# Temp audio
*.wav
*.mp3
!sample_*.wav

# Dashboard runtime state (regenerated by the CLI each turn)
app/state/

# OS / IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Claude Code per-project local settings (machine-specific)
.claude/settings.local.json

# W1.6 sparse BM25 index — large, regenerable in ~1min via scripts/build_sparse_index.py
data/index/pilot_sparse.pkl

# W1.7 full-corpus dense matrix — 36MB, regenerable on GPU in ~17min (build_corpus_dense.py)
data/index/corpus_dense.npy

# Scratch/temp eval outputs (underscore-prefixed) — never evidence
eval/results/_*
